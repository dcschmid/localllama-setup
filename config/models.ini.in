version = 1

# Final production layout (2026-11-24 update): exactly two models.
#   research-code  -> Gemma 4 26B-A4B QAT HauhauCS Balanced (coding/research/Pi)
#   story          -> UltimateIntent Gemory 26B-A4B (story, articles, human writing)
# Every preset pins the full 262144-token window with 8192 output tokens and
# fit=off (no silent context reduction). One model instance at a time; the
# router unloads the previous model before loading the next (--models-max 1).
# Legacy profile names (research, deep-research, human-*, creative-writing,
# coding-*) are kept as API aliases and all resolve to one of the two models,
# because Open WebUI, the studio, Pi and the starter scripts reference them.

[*]
parallel = 1
device = CUDA0
flash-attn = on
threads = 12
threads-batch = 12
batch-size = 512
ubatch-size = 256
fit-target = 1024
cache-ram = 512
sleep-idle-seconds = 900
jinja = true

# ---------------------------------------------------------------------------
# Model A: coding, research, agents (HauhauCS Balanced, QAT Q4_K_M)
# Measured on the RTX 5070 8GB: MoE experts on CPU (cpu-moe), KV q8_0 at the
# full 262144 window, ubatch 64 keeps prefill buffers inside the VRAM budget
# with 1-1.5 GiB desktop reserve. --fit off everywhere.

[research-code]
model = @HOME@/models/gguf/Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
fit = off
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 2048
ubatch-size = 64
cpu-moe = true
temperature = 0.6

[research]
model = @HOME@/models/gguf/Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
fit = off
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 2048
ubatch-size = 64
cpu-moe = true
temperature = 0.6

[deep-research]
model = @HOME@/models/gguf/Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
fit = off
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 2048
ubatch-size = 64
cpu-moe = true
reasoning-budget = 128
temperature = 0.6

[coding-research-26b]
model = @HOME@/models/gguf/Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
