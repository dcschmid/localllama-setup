version = 1

[*]
parallel = 1
device = CUDA0
flash-attn = on
threads = 12
threads-batch = 12
batch-size = 512
ubatch-size = 256
fit-target = 1024
cache-ram = 512
sleep-idle-seconds = 900
jinja = true

[research]
model = @HOME@/models/gguf/gemma-4-26B_q4_0-it.gguf
ctx-size = 262144
n-predict = 8192
cache-type-k = q4_0
cache-type-v = q4_0
batch-size = 2048
ubatch-size = 1024

[deep-research]
model = @HOME@/models/gguf/gemma-4-26B_q4_0-it.gguf
ctx-size = 262144
n-predict = 8192
cache-type-k = q4_0
cache-type-v = q4_0
batch-size = 2048
ubatch-size = 1024
reasoning-budget = 128

[coding-research-26b]
model = @HOME@/models/gguf/gemma-4-26B_q4_0-it.gguf
ctx-size = 262144
n-predict = 8192
batch-size = 2048
ubatch-size = 1024
cache-type-k = q4_0
cache-type-v = q4_0
cpu-moe = true
temperature = 1.0
top-p = 0.95
top-k = 64

[coding-cyber-tiel-35b]
model = @HOME@/models/gguf/Cyber-Tiel-Coder-35B-A3B.APEX-I-MiniPlus-V2.1.gguf
ctx-size = 262144
n-predict = 8192
batch-size = 2048
ubatch-size = 1024
cache-type-k = q4_0
cache-type-v = q4_0

[creative-writing]
model = @HOME@/models/gguf/Gemma-4-12B-StyleTune.Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
cache-type-k = q4_0
cache-type-v = q4_0
reasoning = off
chat-template-file = @HOME@/.cache/llama.cpp/writing/gemma4-human-writing.jinja
chat-template-kwargs = {"writing_mode":"generate","writing_genre":"fiction"}

[human-writing]
model = @HOME@/models/gguf/Gemma-4-12B-StyleTune.Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
cache-type-k = q4_0
cache-type-v = q4_0
reasoning = off
chat-template-file = @HOME@/.cache/llama.cpp/writing/gemma4-human-writing.jinja
chat-template-kwargs = {"writing_mode":"generate","writing_genre":"editorial"}

[human-rewrite]
model = @HOME@/models/gguf/Gemma-4-12B-StyleTune.Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
cache-type-k = q4_0
cache-type-v = q4_0
reasoning = off
chat-template-file = @HOME@/.cache/llama.cpp/writing/gemma4-human-writing.jinja
chat-template-kwargs = {"writing_mode":"rewrite","writing_genre":"editorial"}

[human-audit]
model = @HOME@/models/gguf/Gemma-4-12B-StyleTune.Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
cache-type-k = q4_0
cache-type-v = q4_0
reasoning = off
chat-template-file = @HOME@/.cache/llama.cpp/writing/gemma4-human-writing.jinja
chat-template-kwargs = {"writing_mode":"audit","writing_genre":"editorial"}

# Coding candidates (opt-in evaluation profile, see packages/models-coding-candidates.tsv).
# ./setup.sh install --coding-candidates provides the GGUF files. Each preset runs
# at the model's native context ceiling (qwen35moe: 262144; Mellum2.1 and LFM2.5:
# 131072); the auto-fit placement from [*] keeps the RTX 5070 at its 1 GiB headroom
# and places KV plus oversized tensors on host RAM. MoE models keep their experts
# on the CPU (measured LFM2.5 baseline).

[coding-phai-256k]
model = @HOME@/models/gguf/Phai-A1-35B-1M-MTP.MXFP4_MOE.gguf
ctx-size = 262144
n-predict = 8192
batch-size = 2048
ubatch-size = 1024
cache-type-k = q4_0
cache-type-v = q4_0
cpu-moe = true
temperature = 1.0
top-p = 0.95
top-k = 20

[coding-mellum-12b]
model = @HOME@/models/gguf/Mellum2.1-12B-A2.5B-Thinking-Q4_K_M.gguf
ctx-size = 131072
n-predict = 16384
batch-size = 2048
ubatch-size = 1024
cache-type-k = q4_0
cache-type-v = q4_0
cpu-moe = true
temperature = 0.6
top-p = 0.95
top-k = 20

[coding-lfm-24b]
model = @HOME@/models/gguf/LFM2.5-24B-A2B-Q4_K_M.gguf
ctx-size = 131072
n-predict = 8192
batch-size = 2048
ubatch-size = 1024
cache-type-k = q4_0
cache-type-v = q4_0
cpu-moe = true
temperature = 0.2
top-k = 80
repeat-penalty = 1.05

[coding-ornith-9b]
model = @HOME@/models/gguf/Ornith-1.5-9B-Q4_K_M.gguf
ctx-size = 262144
n-predict = 16384
batch-size = 2048
ubatch-size = 1024
cache-type-k = q4_0
cache-type-v = q4_0
temperature = 0.6
top-p = 0.95
top-k = 20
min-p = 0.0

[coding-kat-35b]
model = @HOME@/models/gguf/Kwaipilot_KAT-Coder-V2.5-Dev-Q4_K_M.gguf
ctx-size = 262144
n-predict = 16384
batch-size = 2048
ubatch-size = 1024
cache-type-k = q4_0
cache-type-v = q4_0
cpu-moe = true
temperature = 1.0
top-p = 0.95
top-k = 20
