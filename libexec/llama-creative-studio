def skill_version() -> str:
    """Version the human-writing skill declares in its own SKILL.md."""
    try:
        head = (SKILLS / "human-writing" / "SKILL.md").read_text(encoding="utf-8")[:2000]
        for line in head.splitlines():
            if "version" in line and ":" in line:
                return line.split(":", 1)[1].strip().strip('"\'')
    except OSError:
        pass
    return "unknown"
