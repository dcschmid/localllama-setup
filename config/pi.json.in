{
  "piVersion": "1.5.2",
  "package": "@earendil-works/pi-coding-agent",
  "agentDir": "@HOME@/.pi/agent",
  "routerUrl": "http://127.0.0.1:8080",
  "defaultProvider": "llama.cpp",
  "defaultModel": "research-code",
  "contextTokens": 262144,
  "outputTokens": 8192,
  "compaction": {
    "enabled": true,
    "reserveTokens": 39322,
    "keepRecentTokens": 20000
  },
  "skills": "@SKILLS@",
  "promptTemplates": [
    "finish",
    "review",
    "fix-ci",
    "finish-docs"
  ],
  "mcpServers": {
    "websearch": {
      "url": "http://127.0.0.1:8642/mcp",
      "exposure": "hidden",
      "toolExposure": { "search_web": "codemode" }
    },
    "context7": {
      "url": "http://127.0.0.1:8643/servers/context7/mcp",
      "exposure": "hidden",
      "toolExposure": { "resolve-library-id": "codemode", "query-docs": "codemode" }
    },
    "github": {
      "url": "http://127.0.0.1:8643/servers/github/mcp",
      "exposure": "hidden",
      "toolExposure": {
        "get_latest_release": "codemode",
        "list_releases": "codemode",
        "get_file_contents": "codemode",
        "search_repositories": "codemode"
      }
    }
  }
}
