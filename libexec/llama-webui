#!/usr/bin/env bash
set -euo pipefail

url=http://127.0.0.1:8080
socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/llama-cpp/server.sock"

message='llama.cpp antwortet nicht. Details: journalctl --user -u llama-cpp.service -n 30'
if systemctl --user start llama-cpp.service; then
    for ((attempt=0; attempt<30; attempt++)); do
        if curl -qfsS --unix-socket "$socket" --max-time 1 "$url/health" >/dev/null 2>&1; then
            [[ ${1:-} == --check ]] && exit 0
            systemctl --user start --no-block llama-cpp-research.service llama-cpp-mcp.service || true
            for ((probe=0; probe<20; probe++)); do
                if curl -qfsS --max-time 0.4 http://127.0.0.1:8642/healthz >/dev/null 2>&1 &&
                   curl -qfsS --max-time 0.4 http://127.0.0.1:8643/status >/dev/null 2>&1; then
                    break
                fi
                sleep 0.2
            done
            if xdg-open "$url"; then
                exit 0
            fi
            message="Der Browser konnte $url nicht öffnen."
            break
        fi
        sleep 0.3
    done
fi

printf '%s\n' "$message" >&2
if [[ ${1:-} != --check ]] && command -v kdialog >/dev/null; then
    kdialog --title 'llama.cpp' --error "$message"
fi
exit 1
