---
import Layout from '../layouts/base.astro';
import { icon } from '../lib/icons';
---
<Layout>
  <div class="app" id="studio">
    <aside class="sidebar" id="sidebar" aria-label="Seitenleiste" data-navigation></aside>
    <div class="stage">
      <header class="topbar">
        <div class="topbar-group">
          <button type="button" class="icon-button" id="nav-toggle" aria-expanded="false" aria-label="Seitenleiste öffnen" set:html={icon('panel')} />
          <span id="location-label">Neuer Chat</span>
        </div>
        <div class="topbar-group" id="header-actions"></div>
      </header>
      <main id="main" tabindex="-1"></main>
    </div>
  </div>
  <dialog id="nav-dialog" aria-label="Seitenleiste"><div data-navigation></div></dialog>
  <dialog id="details" aria-labelledby="details-title"></dialog>
  <p class="sr-only" id="announcement" role="status"></p>
  <script>
    import '../lib/studio';
  </script>
</Layout>
