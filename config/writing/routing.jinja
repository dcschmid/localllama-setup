{#- Human Writing reference selection. The renderer supplies hw_docs from the skill checkout. -#}
{%- set hw = namespace(mode=writing_mode | default('generate'), genre=writing_genre | default('editorial'), lang='en', web=false, facts=false) -%}
{%- for message in messages -%}
    {%- if message.role == 'user' -%}
        {%- set part = namespace(text='') -%}
        {%- if message.content is string -%}
            {%- set part.text = message.content -%}
        {%- else -%}
            {%- for item in message.content -%}
                {%- if not part.text and item.type == 'text' -%}
                    {%- set part.text = item.text -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}
        {%- set line = (part.text | trim | lower).split('\n')[0][:240] -%}
        {%- set tags = line[:120] if line[:1] == '[' else '' -%}
        {%- set hw.web = '[web]' in tags -%}
        {%- if not hw.web -%}
            {%- for ask in ['suche im web ', 'recherchiere im web ', 'recherchiere online ',
                'verwende ausdrücklich unseren websearch mcp', 'verwende den websearch mcp',
                'search the web ', 'research online ', 'use the websearch mcp'] -%}
                {%- if line[:(ask | length)] == ask -%}
                    {%- set hw.web = true -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}
        {%- set hw.facts = '[facts]' in tags or '[fakten]' in tags -%}
        {%- if hw.facts -%}
            {%- set line = line | replace('[facts]', '') | replace('[fakten]', '') | trim -%}
        {%- endif -%}
        {%- set word = line.split(' ')[0] -%}
        {%- if '[de]' in tags -%}
            {%- set hw.lang = 'de' -%}
        {%- elif '[en]' in tags -%}
            {%- set hw.lang = 'en' -%}
        {%- elif 'auf deutsch' in line or 'in german' in line or 'deutsch' in line
            or line[:8] == 'schreibe' or line[:6] == 'verfas' or word == 'prüfe'
            or 'überarbeit' in word or line[:10] == 'kalibriere' -%}
            {%- set hw.lang = 'de' -%}
        {%- elif 'auf englisch' in line or 'in english' in line or 'english' in line -%}
            {%- set hw.lang = 'en' -%}
        {%- endif -%}
        {%- if '[website-rewrite]' in tags or line[:20] == 'rewrite this website' -%}
            {%- set hw.mode = 'website-rewrite' -%}
        {%- elif '[website-audit]' in tags or line[:18] == 'audit this website' -%}
            {%- set hw.mode = 'website-audit' -%}
        {%- elif '[voice]' in tags or line[:9] == 'calibrate' or line[:10] == 'kalibriere' -%}
            {%- set hw.mode = 'voice' -%}
        {%- elif '[rewrite]' in tags or line[:8] == 'rewrite ' or 'überarbeit' in word -%}
            {%- set hw.mode = 'rewrite' -%}
        {%- elif '[audit]' in tags or line[:6] == 'audit ' -%}
            {%- set hw.mode = 'audit' -%}
        {%- elif '[generate]' in tags -%}
            {%- set hw.mode = 'generate' -%}
        {%- endif -%}
        {%- set explicit = namespace(genre=false) -%}
        {%- for genre in ['editorial', 'fiction', 'technical', 'business', 'marketing', 'ux'] -%}
            {%- if '[' + genre + ']' in tags -%}
                {%- set hw.genre = genre -%}
                {%- set explicit.genre = true -%}
            {%- endif -%}
        {%- endfor -%}
        {%- if not explicit.genre and ('devlog' in line or 'blog' in line or 'review' in line) -%}
            {%- set hw.genre = 'editorial' -%}
        {%- elif not explicit.genre and ('short story' in line or 'dialogue scene' in line or 'kurzgeschichte' in line) -%}
            {%- set hw.genre = 'fiction' -%}
        {%- elif not explicit.genre and ('release note' in line or 'readme' in line) -%}
            {%- set hw.genre = 'technical' -%}
        {%- endif -%}
    {%- endif -%}
{%- endfor -%}
{#- For pure writing, hide tool schemas from the rendered model prompt. -#}
{%- set hw_tools = namespace(items=[]) -%}
{%- if hw.web and tools -%}
    {%- for tool in tools -%}
        {%- if tool.function.name in ['search_web', 'read_url', 'websearch_search_web', 'websearch_read_url'] -%}
            {%- set hw_tools.items = hw_tools.items + [tool] -%}
        {%- endif -%}
    {%- endfor -%}
{%- endif -%}
{%- set tools = hw_tools.items -%}
{%- set hw_context -%}
{%- if not studio_skill_context | default(false) -%}
