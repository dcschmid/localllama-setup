{
  "piVersion": "1.5.2",
  "package": "@earendil-works/pi-coding-agent",
  "agentDir": "@HOME@/.pi/agent",
  "routerUrl": "http://127.0.0.1:8080",
  "defaultProvider": "llama.cpp",
  "defaultModel": "research-code",
  "contextTokens": 262144,
  "outputTokens": 8192,
  "compaction": {
    "enabled": true,
    "reserveTokens": 39322,
    "keepRecentTokens": 20000
  },
  "skills": "@SKILLS@",
  "packages": [
    { "name": "pi-lens", "version": "4.5.1", "status": "active" },
    { "name": "pi-permission-modes", "version": "2.7.2", "status": "active" },
    { "name": "pi-workspace-history", "version": "0.5.2", "status": "active" },
    { "name": "pi-todo-agent", "version": "0.3.0", "status": "active" },
    { "name": "pi-condense", "version": "2.18.1", "status": "experimental" },
    { "name": "pi-sessions", "version": "0.23.4", "status": "excluded", "reason": "node>=24, host pins node 22" }
  ],
  "promptTemplates": ["finish", "review", "fix-ci", "finish-docs"],
  "mcpServers": {
    "websearch": "http://127.0.0.1:8642/mcp",
    "context7": "http://127.0.0.1:8643/servers/context7/mcp",
    "github": "http://127.0.0.1:8643/servers/github/mcp"
  }
}
