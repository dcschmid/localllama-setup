# ---------------------------------------------------------------------------
# Model B: story, articles, human writing (UltimateIntent Gemory Q4_K_M).
# Model card: Q4 variants are sampler-sensitive and ship creative defaults;
# Q4 decodes well around temperature 0.2-0.7, do not force one value on every
# role. The Gemory chat template and SWA checkpoints stay untouched.

[story]
model = @HOME@/models/gguf/Gemory-26B-A4B-Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
fit = off
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 2048
ubatch-size = 64
cpu-moe = true
temperature = 0.7
top-p = 0.95
top-k = 64

[creative-writing]
model = @HOME@/models/gguf/Gemory-26B-A4B-Q4_K_M.gguf
sleep-idle-seconds = 15
ctx-size = 262144
n-predict = 8192
fit = off
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 2048
ubatch-size = 64
cpu-moe = true
reasoning = off
chat-template-file = @HOME@/.cache/llama.cpp/writing/gemma4-human-writing.jinja
chat-template-kwargs = {"writing_mode":"generate","writing_genre":"fiction"}
temperature = 0.7
top-p = 0.95
top-k = 64

[human-writing]
model = @HOME@/models/gguf/Gemory-26B-A4B-Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
fit = off
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 2048
ubatch-size = 64
cpu-moe = true
reasoning = off
chat-template-file = @HOME@/.cache/llama.cpp/writing/gemma4-human-writing.jinja
chat-template-kwargs = {"writing_mode":"generate","writing_genre":"editorial"}
temperature = 0.7
top-p = 0.95
top-k = 64

[human-rewrite]
model = @HOME@/models/gguf/Gemory-26B-A4B-Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
fit = off
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 2048
ubatch-size = 64
cpu-moe = true
reasoning = off
chat-template-file = @HOME@/.cache/llama.cpp/writing/gemma4-human-writing.jinja
chat-template-kwargs = {"writing_mode":"rewrite","writing_genre":"editorial"}
temperature = 0.7
top-p = 0.95
top-k = 64

[human-audit]
model = @HOME@/models/gguf/Gemory-26B-A4B-Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
fit = off
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 2048
ubatch-size = 64
cpu-moe = true
reasoning = off
chat-template-file = @HOME@/.cache/llama.cpp/writing/gemma4-human-writing.jinja
chat-template-kwargs = {"writing_mode":"audit","writing_genre":"editorial"}
temperature = 0.2
top-p = 0.95
top-k = 64

# Pi's global models-store (user settings) references coding-long-256k as its
# default model id; keep it as an alias of the coding model so the installed
# Pi harness keeps working without touching the user's private store.
[coding-long-256k]
model = @HOME@/models/gguf/Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-Q4_K_M.gguf
ctx-size = 262144
n-predict = 8192
fit = off
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 2048
ubatch-size = 64
cpu-moe = true
temperature = 0.6
