---
import Layout from '../layouts/base.astro';
import { SECTIONS } from '../lib/core';
const nav = SECTIONS.map((id) => ({ id, label: id }));
---
<Layout>
  <div class="shell">
    <header class="topbar">
      <div class="brand">Creative Studio<small>local · 127.0.0.1</small></div>
      <nav class="sections" aria-label="Bereiche">
        {nav.map(({ id }) => (<button data-section={id} id={`nav-${id}`}>{id}</button>))}
      </nav>
      <button class="btn" id="toggle-theme" aria-pressed="false">Dunkel</button>
    </header>
    <div class="body" id="body">
      <aside id="sidebar" aria-label="Projekte und Bibliothek"></aside>
      <main id="main" tabindex="-1"></main>
      <section class="inspector" id="inspector" aria-label="Inspektor"></section>
    </div>
  </div>
  <script>
    import { api, prefs, sectionLabel, type Section } from '../lib/core';
    import { renderChat } from '../lib/chat';
    import { renderLibrary } from '../lib/library';
    import { renderStories } from '../lib/stories';
    import { renderImages } from '../lib/images';
    import { renderResearch, renderArticles, renderGame } from '../lib/sections';
    import { renderPublish, renderSettings } from '../lib/publish';

    const main = document.getElementById('main')!;
    const sidebar = document.getElementById('sidebar')!;
    const inspector = document.getElementById('inspector')!;
    const body = document.getElementById('body')!;
    const SECTIONS = [...document.querySelectorAll('[data-section]')] as HTMLButtonElement[];

    function current(): Section {
      const h = location.hash.slice(1) as Section;
      return (SECTIONS.some((b) => b.dataset.section === h) ? h : 'chat') as Section;
    }
    async function render() {
      const sec = current();
      for (const b of SECTIONS) {
        b.setAttribute('aria-current', b.dataset.section === sec ? 'page' : 'false');
      }
      main.innerHTML = ''; inspector.innerHTML = ''; sidebar.innerHTML = '';
      document.documentElement.lang = prefs.lang;
      if (sec === 'chat') {
        await renderChat(main, sidebar, inspector);
      } else if (sec === 'stories') {
        await renderStories(main, sidebar, inspector);
      } else if (sec === 'images') {
        await renderImages(main, sidebar, inspector);
      } else if (sec === 'research') {
        await renderResearch(main, sidebar, inspector);
      } else if (sec === 'articles') {
        await renderArticles(main, sidebar, inspector);
      } else if (sec === 'game') {
        await renderGame(main, sidebar, inspector);
      } else if (sec === 'publish') {
        await renderPublish(main, sidebar, inspector);
      } else if (sec === 'settings') {
        await renderSettings(main, sidebar, inspector);
      } else if (sec === 'library') {
        await renderLibrary(main, sidebar, inspector);
      } else {
        main.innerHTML =
          `<h1>${sectionLabel(sec)}</h1><p class="muted">Dieser Bereich wird in der
           vorgesehenen Phase umgesetzt. Chat und Bibliothek sind bereits funktionsfähig.</p>`;
      }
    }
    addEventListener('hashchange', render);
    document.getElementById('toggle-theme')!.addEventListener('click', (e) => {
      const next = prefs.theme === 'dark' ? 'light' : 'dark';
      prefs.theme = next;
      document.documentElement.dataset.theme = next;
      (e.target as HTMLButtonElement).textContent = next === 'dark' ? 'Hell' : 'Dunkel';
      (e.target as HTMLButtonElement).setAttribute('aria-pressed', String(next === 'dark'));
    });
    render();
  </script>
</Layout>
